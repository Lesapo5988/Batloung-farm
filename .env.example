# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (MySQL via mysql2)
# Set DB_ENGINE=mysql and provide your MySQL server credentials to connect to MySQL.
# When DB_HOST is omitted, the server runs the local embedded SQLite engine automatically.
DB_ENGINE=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=batloung_farm_db
SQLITE_PATH=./server/database/batloung_farm.db

# Optional AI / App URL variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
